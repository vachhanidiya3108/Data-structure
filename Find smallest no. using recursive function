#include <stdio.h>
int findSmallest(int arr[], int n)
{
    if(n == 1)
        return arr[0];
    int small = findSmallest(arr, n - 1);
    if(arr[n-1] < small)
        return arr[n-1];
    else
        return small;
}
int main()
{
    int arr[100], n, i;
    printf("Enter size of array: ");
    scanf("%d", &n);
    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }
   printf("Smallest number = %d", findSmallest(arr, n));
    return 0;
}

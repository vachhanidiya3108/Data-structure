#include <iostream>
using namespace std;
void reverseArray(int *ptr, int n)
{
    ptr = ptr + n - 1;  // Point to last element
    cout << "Array in reverse order: ";
    for (int i = n - 1; i >= 0; i--)
    {
        cout << *ptr << " ";
        ptr--;
    }
}
int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    reverseArray(arr, n);
    return 0;
}

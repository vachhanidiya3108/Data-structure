#include <stdio.h>
int gcd(int a, int b)
{
    if(a == b)
        return a;
    else if(a > b)
        return gcd(a - b, b);
    else
        return gcd(a, b - a);
}
int main()
{
    int a, b;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);
    printf("GCD = %d", gcd(a, b));
    return 0;
}

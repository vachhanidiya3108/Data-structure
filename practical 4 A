#include <iostream>
#include <string>
using namespace std;
class Stack
{
    char arr[100];
    int top;
public:
    Stack()
    {
        top = -1;
    }
    void push(char ch)
    {
        arr[++top] = ch;
    }
    char pop()
    {
        return arr[top--];
    }
    char peek()
    {
        return arr[top];
    }
    bool isEmpty()
    {
        return top == -1;
    }
};
int priority(char ch)
{
    if (ch == '^')
        return 3;
    else if (ch == '*' || ch == '/')
        return 2;
    else if (ch == '+' || ch == '-')
        return 1;
    else
        return 0;
}
bool isOperator(char ch)
{
    return ch == '+' || ch == '-' || ch == '*' ||
           ch == '/' || ch == '^';
}
string infixToPostfix(string infix)
{
    Stack s;
    string postfix = "";
    for (int i = 0; i < infix.length(); i++)
    {
        char ch = infix[i];
        if ((ch >= 'A' && ch <= 'Z') ||
            (ch >= 'a' && ch <= 'z') ||
            (ch >= '0' && ch <= '9'))
        {
            postfix += ch;
        }
        else if (ch == '(')
        {
            s.push(ch);
        }
        else if (ch == ')')
        {
            while (!s.isEmpty() && s.peek() != '(')
            {
                postfix += s.pop();
            }
            s.pop(); // Remove '('
        }

        else if (isOperator(ch))
        {
            while (!s.isEmpty() &&
                   priority(s.peek()) >= priority(ch))
            {
                postfix += s.pop();
            }

            s.push(ch);
        }
    }
    while (!s.isEmpty())
    {
        postfix += s.pop();
    }
    return postfix;
}
int main()
{
    string infix;
    cout << "Enter an infix expression: ";
    cin >> infix;
    cout << "Postfix expression: "
         << infixToPostfix(infix);
    return 0;
}

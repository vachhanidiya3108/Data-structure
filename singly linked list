#include <iostream>
using namespace std;

struct node
{
    int data;
    node *next;
};

node *first = NULL;

node* create_node(int x)
{
    node *temp = new node;

    temp->data = x;
    temp->next = NULL;

    return temp;
}

void insert_begin(int x)
{
    node *temp = create_node(x);

    temp->next = first;
    first = temp;
}

void insert_end(int x)
{
    node *temp = create_node(x);
    node *p;

    if(first == NULL)
    {
        first = temp;
    }
    else
    {
        p = first;

        while(p->next != NULL)
        {
            p = p->next;
        }

        p->next = temp;
    }
}

void insert_after(int x, int value)
{
    node *p = first;

    while(p != NULL && p->data != value)
    {
        p = p->next;
    }

    if(p == NULL)
    {
        cout << "Node not found";
    }
    else
    {
        node *temp = create_node(x);

        temp->next = p->next;
        p->next = temp;
    }
}

void delete_first()
{
    node *temp;

    if(first == NULL)
    {
        cout << "List is empty";
    }
    else
    {
        temp = first;
        first = first->next;
        delete temp;
    }
}

void delete_last()
{
    node *p, *temp;

    if(first == NULL)
    {
        cout << "List is empty";
    }
    else if(first->next == NULL)
    {
        delete first;
        first = NULL;
    }
    else
    {
        p = first;

        while(p->next->next != NULL)
        {
            p = p->next;
        }

        temp = p->next;
        p->next = NULL;

        delete temp;
    }
}

void delete_after(int value)
{
    node *p = first;

    while(p != NULL && p->data != value)
    {
        p = p->next;
    }

    if(p == NULL || p->next == NULL)
    {
        cout << "Node not found";
    }
    else
    {
        node *temp = p->next;

        p->next = temp->next;
        delete temp;
    }
}

void display()
{
    node *p = first;

    if(first == NULL)
    {
        cout << "List is empty";
    }
    else
    {
        while(p != NULL)
        {
            cout << p->data << " -> ";
            p = p->next;
        }

        cout << "NULL";
    }
}
int main()
{
    int choice, x, value;

    while(1)
    {
        cout << "\n1. Insert at Beginning";
        cout << "\n2. Insert at End";
        cout << "\n3. Insert After Given Node";
        cout << "\n4. Delete First Node";
        cout << "\n5. Delete Last Node";
        cout << "\n6. Delete After Given Node";
        cout << "\n7. Display";
        cout << "\n8. Exit";

        cout << "\n\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                insert_begin(x);
                break;

            case 2:
                cout << "Enter value: ";
                cin >> x;
                insert_end(x);
                break;

            case 3:
                cout << "Enter value to insert: ";
                cin >> x;

                cout << "Enter node after which to insert: ";
                cin >> value;

                insert_after(x, value);
                break;

            case 4:
                delete_first();
                break;

            case 5:
                delete_last();
                break;

            case 6:
                cout << "Enter node after which to delete: ";
                cin >> value;

                delete_after(value);
                break;

            case 7:
                display();
                break;

            case 8:
                return 0;

            default:
                cout << "Invalid choice";
        }
    }
}
